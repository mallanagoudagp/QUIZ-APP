# Copy this file to .env and fill in your own values.
# Get a free Gemini key at https://aistudio.google.com/apikey
# or a free Groq key at https://console.groq.com/keys

LLM_PROVIDER=mock          # "gemini" | "groq" | "mock"
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b # Gemini: gemini-2.0-flash | Groq: openai/gpt-oss-120b or qwen/qwen3.8-27b | ignored for mock

PORT=8787

# Leave LLM_PROVIDER=mock (no key needed) to develop the UI against a
# built-in fake responder that can simulate good, malformed, empty and
# slow/failed responses. See server/mockProvider.js.

# --- Optional: accounts + cross-device personalization -------------------
# Beyond the assignment's stated requirements ("No auth needed"). Leave both
# blank and the app runs in guest mode: no sign-in UI, progress kept in this
# browser's localStorage only — nothing else changes.
#
# To enable: create a free project at https://supabase.com, run
# supabase/schema.sql in its SQL editor, then paste the values from
# Project Settings -> API below. The anon key is safe to expose in the
# browser; Row Level Security in schema.sql is what keeps data private.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
